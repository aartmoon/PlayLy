CORE_PORT=8080
PLAYLY_JWT_SECRET=playly-local-only-change-this-secret-before-deploying
POSTGRES_PASSWORD=playly-local
RUSTFS_ACCESS_KEY=playly
RUSTFS_SECRET_KEY=playly-local
S3_GAME_BUCKET=playly-games
RUSTFS_API_PORT=9000
# S3_PUBLIC_ENDPOINT=https://storage.example.com
RUSTFS_CONSOLE_PORT=9001
