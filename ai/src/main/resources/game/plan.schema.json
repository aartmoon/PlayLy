{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayLy game plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["entryPoint", "assetRefs", "requirements", "groups"],
  "properties": {
    "entryPoint": {"$ref": "#/definitions/sourcePath"},
    "assetRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/text"}
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"$ref": "#/definitions/text"},
          "description": {"$ref": "#/definitions/text"}
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dependsOn", "files"],
        "properties": {
          "id": {"$ref": "#/definitions/text"},
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/definitions/text"}
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "purpose", "contracts"],
              "properties": {
                "path": {"$ref": "#/definitions/sourcePath"},
                "purpose": {"$ref": "#/definitions/text"},
                "contracts": {
                  "type": "array",
                  "items": {"$ref": "#/definitions/text"}
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "text": {"type": "string", "pattern": "\\S"},
    "sourcePath": {
      "type": "string",
      "pattern": "^src/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.ts$"
    }
  }
}
