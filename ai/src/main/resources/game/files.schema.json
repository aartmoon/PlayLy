{
  "type": "object",
  "additionalProperties": false,
  "required": ["files", "done", "remaining"],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": {"type": "string", "description": "Relative path such as src/scenes/Game.ts"},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "done": {"type": "boolean"},
    "remaining": {"type": "string", "description": "Empty if done, otherwise describe the work left"}
  }
}
