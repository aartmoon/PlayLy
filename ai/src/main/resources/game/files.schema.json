{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayLy generated file group",
  "type": "object",
  "additionalProperties": false,
  "required": ["responseVersion", "files"],
  "properties": {
    "responseVersion": {"const": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "content"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.ts$"},
          "path": {"type": "string", "pattern": "^src(?:/[A-Za-z0-9_-]+)*$"},
          "content": {"type": "string", "pattern": "\\S"}
        }
      }
    }
  }
}
